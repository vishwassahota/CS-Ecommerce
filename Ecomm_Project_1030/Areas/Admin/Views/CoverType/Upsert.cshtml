@model Ecomm_Project_1030.Models.CoverType
@{
    ViewData["Title"] = "Upsert";
    var title = Model.Id == 0 ? "New CoverType" : "Edit CoverType";
}

<form method="post">
    <div class="row">
        <div class="col-9 border-bottom ">
            <h1 class="text-primary text-center ">@title</h1>
        </div>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-8 p-3 m-3">
            <div class="form-group row">
                <div class="col-2">
                    <label asp-for="@Model.Name"></label>
                </div>
                <div class="col-10">
                    <input asp-for="@Model.Name" class="form-control " />
                    <span asp-validation-for="@Model.Name" class="text-danger"></span>
                </div>
            </div>
            <div class="offset-2">
                @if (Model.Id == 0)
                {
                    <partial name="_SaveAndBackToListButton" />
                }
                else
                {
                    <partial name="_EditAndBackToListButton" />
                } 
            </div>
        </div>
    </div>
</form>
@section scripts
{
    <partial name="_ValidationScriptsPartial" />
}

