@model IEnumerable<Ecomm_Project_1030.Models.Company>

<div class="row">
    <div class="col-9">
        <h2 class="text-primary ">New Company</h2>
    </div>
    <div class="col-3">
        <a asp-controller="Company" asp-area="Admin" asp-action="Upsert" class="btn btn-primary form-control">
            <i class="fas fa-plus"></i>&nbsp; New Company
        </a>
    </div>
</div>
<br />

<table id="TblData" class=" table  table-hover table-striped table-bordered ">
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>City</th>
            <th>State</th>
            <th>Phone Number</th>
            <th>Is Authorized</th>
            <th>Action</th>
        </tr>
    </thead>
</table>
@section scripts
{
<script src="~/js/Company.js"></script>
}
